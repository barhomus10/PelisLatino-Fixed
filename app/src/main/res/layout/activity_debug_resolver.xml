<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛠️ Debug Resolver de Películas"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnPeliEjemplo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Probar con ID de ejemplo"/>

    <Button
        android:id="@+id/btnPeliId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Probar con ID específico"/>

    <Button
        android:id="@+id/btnVerLogs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver Dominios Probados"/>

    <TextView
        android:id="@+id/txtResultados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Los resultados aparecerán aquí..."
        android:textSize="14sp"/>

</LinearLayout>