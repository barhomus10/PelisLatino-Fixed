<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo transparente para que el CardView oscuro se vea -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" /> <!-- transparente -->
        </shape>
    </item>
    <!-- Línea inferior blanca con opacidad baja -->
    <item android:top="-1dp" android:bottom="-1dp" android:left="-1dp" android:right="-1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5dp"
                android:color="#33FFFFFF" /> <!-- línea muy tenue -->
        </shape>
    </item>
</layer-list>