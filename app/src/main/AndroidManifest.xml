<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name="androidx.multidex.MultiDexApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="PelisLatinoHD"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PelisLatinoHD"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        
        <activity
            android:name="com.pelislatinohd.app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PelisLatinoHD">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.pelislatinohd.app.DetailActivity"
            android:exported="false"
            android:parentActivityName="com.pelislatinohd.app.MainActivity" />

        <activity
            android:name="com.pelislatinohd.app.SearchActivity"
            android:exported="false" />

        <activity
            android:name="com.pelislatinohd.app.PlayerActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />

    </application>

</manifest>
